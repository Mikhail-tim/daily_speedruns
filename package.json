{
  "name": "daily-speedruns",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build -w packages/shared",
    "test": "npm run test -w packages/shared",
    "db:init:local": "npm run db:init:local -w packages/server"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
